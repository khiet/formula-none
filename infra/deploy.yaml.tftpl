schemaVersion: "2.2"
description: Pull the server image for one commit and restart the Compose stack from the bundle it carries.
parameters:
  ImageTag:
    type: String
    description: Tag of the image in the ECR repository, normally the commit SHA.
    allowedPattern: "^[A-Za-z0-9._-]{1,128}$"
mainSteps:
  - action: aws:runShellScript
    name: deploy
    inputs:
      timeoutSeconds: "600"
      workingDirectory: ${work_dir}
      runCommand:
        - set -euo pipefail
        - aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}
        - export SERVER_IMAGE="${repository_url}:{{ ImageTag }}"
        - docker pull "$SERVER_IMAGE"
        # The image carries its Compose file, Caddyfile and built client
        # under /release; the stack always runs from the deployed commit's copy.
        - container=$(docker create "$SERVER_IMAGE")
        - rm -rf release.next && docker cp "$container:/release" release.next && docker rm "$container"
        - rm -rf release && mv release.next release
        - docker compose -f release/compose.yaml pull
        - docker compose -f release/compose.yaml up -d --remove-orphans
        - docker image prune -f
