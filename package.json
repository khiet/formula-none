{
  "name": "formula-none",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:bridge": "wasm-pack build crates/bridge --target web --out-dir ../../apps/web/src/generated/bridge --out-name bridge --no-pack",
    "export:tracks": "blender --background --python assets/tracks/build.py -- all",
    "build": "pnpm -r build",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
